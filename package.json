{
  "name": "7pacific-headless-storefront",
  "private": true,
  "sideEffects": false,
  "version": "2026.10.2",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "react-router build",
    "dev": "hydrogen skills check --mode=warn && vite dev",
    "preview": "react-router build && vite preview",
    "deploy": "shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "type-check": "react-router typegen && tsc --noEmit && hydrogen gql check --fail-on-warn",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "depcruise": "depcruise app",
    "prepare": "husky",
    "test": "vitest run",
    "test:pixel": "META_PIXEL_STUB=1 playwright test",
    "test:pixel:live": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@posthog/react": "^1.11.1",
    "@shopify/hydrogen": "^2026.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.22",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "posthog-js": "^1.434.9",
    "posthog-node": "^5.52.5",
    "radix-ui": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^15.14.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.12 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
